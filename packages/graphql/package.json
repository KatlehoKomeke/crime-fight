{
  "name": "@civic/graphql",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The GraphQL contract: printed schema, typed client documents and the persisted-operation manifest.",
  "exports": {
    ".": "./src/index.ts",
    "./persisted-documents.json": "./src/gql/persisted-documents.json",
    "./schema.graphql": "./schema.graphql"
  },
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^17.0.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "typescript": "~6.0.3"
  }
}
