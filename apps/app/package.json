{
  "name": "@civic/app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "expo export --platform web && node scripts/package-lambda.mjs",
    "serve": "node scripts/serve-local.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json",
    "doctor": "expo install --check"
  },
  "dependencies": {
    "@civic/core": "workspace:*",
    "@civic/graphql": "workspace:*",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/ui": "~58.0.25",
    "@urql/core": "^6.0.3",
    "@urql/exchange-auth": "^3.0.0",
    "@urql/exchange-graphcache": "^9.0.2",
    "@urql/exchange-persisted": "^5.0.1",
    "expo": "~58.0.21",
    "expo-auth-session": "~58.0.16",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.28",
