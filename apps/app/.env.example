# Web (SSR server) runtime config — read per request, never bundled.
CIVIC_STAGE=local
CIVIC_AUTH_MODE=dev
CIVIC_PUBLIC_API_URL=http://localhost:4000/graphql
CIVIC_API_INTERNAL_URL=http://localhost:4000/graphql
CIVIC_SITE_URL=http://localhost:8081
# CIVIC_COGNITO_DOMAIN=civicone-qa-123456789012.auth.af-south-1.amazoncognito.com
# CIVIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Native builds (baked in at build time; set these in EAS environments for qa/prod).
# EXPO_PUBLIC_API_URL=https://<SiteUrl>/graphql
# EXPO_PUBLIC_SITE_URL=https://<SiteUrl>
# EXPO_PUBLIC_AUTH_MODE=cognito
# EXPO_PUBLIC_COGNITO_DOMAIN=
# EXPO_PUBLIC_COGNITO_CLIENT_ID=
