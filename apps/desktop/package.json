{
  "name": "@civic/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "CIVIC/ONE for macOS, Windows and Linux",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --publish never",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3"
  },
  "build": {
    "appId": "app.civicone.desktop",
    "productName": "CIVIC/ONE",
    "directories": { "output": "release" },
    "files": ["dist/**", "package.json"],
    "protocols": [{ "name": "CIVIC/ONE", "schemes": ["civicone"] }],
    "mac": { "category": "public.app-category.news", "target": ["dmg", "zip"], "hardenedRuntime": true },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage", "deb"], "category": "News" }
  }
}
