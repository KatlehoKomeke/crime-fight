# Local development defaults (all optional).
DATABASE_URL=postgres://civic:civic@localhost:54329/civic
PORT=4000
STAGE=local
# dev: trust the x-dev-user header (refused in qa/prod). cognito: verify Cognito ID tokens.
AUTH_MODE=dev
CORS_ORIGINS=http://localhost:8081
# COGNITO_USER_POOL_ID=af-south-1_XXXXXXXXX
# PERSISTED_ONLY=true
# Deployed only: publish inbox events to AppSync Events. Locally the dev server serves them itself.
# REALTIME_HTTP_HOST=xxxx.appsync-api.af-south-1.amazonaws.com
# Bounty money: sandbox (local only, pretend payments) | paystack (needs PAYSTACK_SECRET_KEY) | disabled (read-only board).
PAYMENTS_PROVIDER=sandbox
# PAYSTACK_SECRET_KEY=sk_test_...
# Where checkout sends people back to.
SITE_URL=http://localhost:8081
# Who reviews bounties and releases money (handles). Locally the newsroom demo account.
ADMIN_HANDLES=civicone
